.5a1 1 0 0 1 1-1z\" />\r\n                            <path\r\n                                d=\"M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z\" />\r\n                        </svg>\r\n                    </button>\r\n                </div>\r\n\r\n                <router-link to=\"/Docs\" class=\"Glass-Panel-10 with-hover docs-link\">\r\n                    <span>Read The Docs</span>\r\n                    <svg class=\"svg-icon\" xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" fill=\"currentColor\"\r\n                        viewBox=\"0 0 16 16\">\r\n                        <path\r\n                            d=\"M8.5 2.687c.654-.689 1.782-.886 3.112-.752 1.234.124 2.503.523 3.388.893v9.923c-.918-.35-2.107-.692-3.287-.81-1.094-.111-2.278-.039-3.213.492zM8 1.783C7.015.936 5.587.81 4.287.94c-1.514.153-3.042.672-3.994 1.105A.5.5 0 0 0 0 2.5v11a.5.5 0 0 0 .707.455c.882-.4 2.303-.881 3.68-1.02 1.409-.142 2.59.087 3.223.877a.5.5 0 0 0 .78 0c.633-.79 1.814-1.019 3.222-.877 1.378.139 2.8.62 3.681 1.02A.5.5 0 0 0 16 13.5v-11a.5.5 0 0 0-.293-.455c-.952-.433-2.48-.952-3.994-1.105C10.413.809 8.985.936 8 1.783\" />\r\n                    </svg>\r\n                </router-link>\r\n            </div>\r\n        </div>\r\n    </header>\r\n    <GetStarted />\r\n    <WhyVitralCSS />\r\n    <HomeFeatures />\r\n    <DemoPreview />\r\n    <GitHubCTA />\r\n    <FooterLinks />\r\n</template>\r\n\r\n<script>\r\nimport GetStarted from './home/GetStarted.vue';\r\nimport WhyVitralCSS from './home/WhyVitralCSS.vue';\r\nimport HomeFeatures from './home/HomeFeatures.vue';\r\nimport DemoPreview from './home/DemoPreview.vue';\r\nimport GitHubCTA from './home/GitHubCTA.vue';\r\nimport FooterLinks from './home/FooterLinks.vue';\r\n\r\nexport default {\r\n    name: 'HomeView',\r\n    components: {\r\n        GetStarted,\r\n        WhyVitralCSS,\r\n        HomeFeatures,\r\n        DemoPreview,\r\n        GitHubCTA,\r\n        FooterLinks\r\n    },\r\n    methods: {\r\n        CopyCode() {\r\n            const textToCopy = \"npm i vitracss\";\r\n            if (navigator.clipboard) {\r\n                navigator.clipboard.writeText(textToCopy).then(() => {\r\n                    alert(\"Copied to clipboard!\");\r\n                });\r\n            }\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* *{\r\n    border: solid red 1px !important;\r\n} */\r\n\r\nheader {\r\n    background-image: url('../assets/images/home-images/HomeBG.webp');\r\n    background-size: cover;\r\n    background-position: center;\r\n    align-items: center;\r\n    justify-content: center;\r\n    display: flex;\r\n    height: 100vh;\r\n    width: 100vw;\r\n}\r\n\r\n.title-box {\r\n    text-align: center;\r\n    color: #F2FFFF;\r\n    font-family: 'frutiger';\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n    background-color: rgba(14, 56, 75, 0.226);\r\n    width: 90%;\r\n}\r\n\r\n.title-box p:first-of-type {\r\n    opacity: 0.9;\r\n}\r\n\r\n.title-box h1 {\r\n    font-weight: bold;\r\n    text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);\r\n}\r\n\r\n.subtittle {\r\n    font-size: 22px;\r\n}\r\n\r\n.tittle {\r\n    font-size: 30px;\r\n}\r\n\r\n.cta-container {\r\n    width: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n    justify-content: space-around;\r\n\r\n}\r\n\r\n.code-box {\r\n    position: relative;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-around;\r\n    background-color: rgba(0, 0, 0, 0.514);\r\n    width: 100%;\r\n    height: 1vh;\r\n}\r\n\r\n.code-box code {\r\n    font-family: 'frutiger';\r\n    color: aliceblue;\r\n    font-size: 20px;\r\n}\r\n\r\n.code-box button {\r\n    background-color: transparent;\r\n    color: aliceblue;\r\n    border: none;\r\n    display: flex;\r\n    align-items: center;\r\n}\r\n\r\n.docs-link {\r\n    position: relative;\r\n    top: 2vh;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: space-around;\r\n    background-color: rgba(0, 0, 0, 0.137);\r\n    color: aliceblue;\r\n    text-decoration: none;\r\n    width: 100%;\r\n    height: 1vh;\r\n    font-size: 20px;\r\n}\r\n\r\n.svg-icon{\r\n        width: 1.5rem;\r\n        height: 1.5rem;\r\n    }\r\n\r\n/* ============================================\r\n   MEDIAS QUERIES - HOME\r\n   ============================================ */\r\n\r\n/* Base: móviles pequeños (< 480px) - Estilos por defecto */\r\n\r\n/* #1 - Móviles 480px+ */\r\n@media screen and (min-width: 480px) {\r\n    header {\r\n        height: 100vh;\r\n        width: 100vw;\r\n    }\r\n\r\n    .title-box {\r\n        width: 90%;\r\n    }\r\n\r\n    .subtittle {\r\n        font-size: 30px;\r\n    }\r\n\r\n    .tittle {\r\n        font-size: 50px;\r\n    }\r\n\r\n    .code-box,\r\n    .docs-link {\r\n        width: 100%;\r\n        height: 1vh;\r\n    }\r\n\r\n    .code-box code,\r\n    .docs-link span {\r\n        width: 80%;\r\n        font-size: 28px;\r\n        text-align: left;\r\n    }\r\n\r\n    .code-box button,\r\n    .docs-link svg {\r\n        width: 10%;\r\n        justify-content: end;\r\n    }\r\n\r\n    .svg-icon{\r\n        width: 2rem;\r\n        height: 2rem;\r\n    }\r\n}\r\n\r\n/* #2 - Tablets 768px+ */\r\n@media screen and (min-width: 768px) {\r\n    header {\r\n        height: 80vh;\r\n    }\r\n\r\n    .title-box {\r\n        width: 90%;\r\n    }\r\n\r\n    .subtittle {\r\n        font-size: 35px;\r\n    }\r\n\r\n    .tittle {\r\n        font-size: 60px;\r\n    }\r\n\r\n    .cta-container{\r\n        flex-direction: row;\r\n    }\r\n\r\n    .code-box{\r\n        width: 45%;\r\n        height: 7vh;\r\n    }\r\n    \r\n    .docs-link{\r\n        top: 0vh;\r\n        width: 45%;\r\n        height: 7vh;\r\n    }\r\n\r\n    .svg-icon{\r\n        width: 2.5rem;\r\n        height: 2.5rem;\r\n    }\r\n}\r\n\r\n/* #3 - Desktop 1024px+ */\r\n@media screen and (min-width: 1024px) {\r\n    header {\r\n        height: 80vh;\r\n    }\r\n\r\n    .title-box {\r\n        width: 80%;\r\n    }\r\n\r\n    .subtittle {\r\n        font-size: 35px;\r\n    }\r\n\r\n    .tittle {\r\n        font-size: 60px;\r\n    }\r\n\r\n    .cta-container{\r\n        flex-direction: row;\r\n    }\r\n\r\n    .code-box{\r\n        width: 45%;\r\n        height: 10vh;\r\n    }\r\n    \r\n    .docs-link{\r\n        top: 0vh;\r\n        width: 45%;\r\n        height: 10vh;\r\n    }\r\n\r\n    .code-box code,\r\n    .docs-link span{\r\n        font-size: 35px;\r\n    }\r\n\r\n    .code-box button,\r\n    .docs-link svg {\r\n        width: 10%;\r\n        justify-content: end;   \r\n    }\r\n\r\n    .svg-icon{\r\n        width: 2.5rem;\r\n        height: 2.5rem;\r\n    }\r\n}\r\n\r\n/* #4 - Large Desktop 1440px+ */\r\n@media screen and (min-width: 1440px) {\r\n    header {\r\n        height: 80vh;\r\n    }\r\n\r\n    .title-box {\r\n        width: 60%;\r\n    }\r\n\r\n    .subtittle {\r\n        font-size: 40px;\r\n    }\r\n\r\n    .tittle {\r\n        font-size: 90px;\r\n    }\r\n\r\n    .cta-container{\r\n        flex-direction: row;\r\n    }\r\n\r\n    .code-box{\r\n        width: 45%;\r\n        height: 10vh;\r\n    }\r\n    \r\n    .docs-link{\r\n        top: 0vh;\r\n        width: 45%;\r\n        height: 10vh;\r\n    }\r\n\r\n    .code-box code,\r\n    .docs-link span{\r\n        font-size: 35px;\r\n    }\r\n\r\n    .code-box button,\r\n    .docs-link svg {\r\n        width: 10%;\r\n        justify-content: end;   \r\n    }\r\n\r\n    .svg-icon{\r\n        width: 2.5rem;\r\n        height: 2.5rem;\r\n    }\r\n}\r\n\r\n/* #5 - Ultra-wide 1920px+ */\r\n@media screen and (min-width: 1910px) {\r\n    header {\r\n        height: 80vh;\r\n    }\r\n\r\n    .title-box {\r\n        width: 70%;\r\n    }\r\n\r\n    .subtittle {\r\n        font-size: 40px;\r\n    }\r\n\r\n    .tittle {\r\n        font-size: 90px;\r\n    }\r\n\r\n    .cta-container{\r\n        flex-direction: row;\r\n    }\r\n\r\n    .code-box{\r\n        width: 45%;\r\n        height: 10vh;\r\n    }\r\n    \r\n    .docs-link{\r\n        top: 0vh;\r\n        width: 45%;\r\n        height: 10vh;\r\n    }\r\n\r\n    .code-box code,\r\n    .docs-link span{\r\n        font-size: 35px;\r\n    }\r\n\r\n    .code-box button,\r\n    .docs-link svg {\r\n        width: 10%;\r\n        justify-content: end;   \r\n    }\r\n\r\n    .svg-icon{\r\n        width: 2.5rem;\r\n        height: 2.5rem;\r\n    }\r\n}\r\n</style>\r\n"],"mappings":"AAyCA,OAAOA,UAAS,MAAO,uBAAuB;AAC9C,OAAOC,YAAW,MAAO,yBAAyB;AAClD,OAAOC,YAAW,MAAO,yBAAyB;AAClD,OAAOC,WAAU,MAAO,wBAAwB;AAChD,OAAOC,SAAQ,MAAO,sBAAsB;AAC5C,OAAOC,WAAU,MAAO,wBAAwB;AAEhD,eAAe;EACXC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IACRP,UAAU;IACVC,YAAY;IACZC,YAAY;IACZC,WAAW;IACXC,SAAS;IACTC;EACJ,CAAC;EACDG,OAAO,EAAE;IACLC,QAAQA,CAAA,EAAG;MACP,MAAMC,UAAS,GAAI,gBAAgB;MACnC,IAAIC,SAAS,CAACC,SAAS,EAAE;QACrBD,SAAS,CAACC,SAAS,CAACC,SAAS,CAACH,UAAU,CAAC,CAACI,IAAI,CAAC,MAAM;UACjDC,KAAK,CAAC,sBAAsB,CAAC;QACjC,CAAC,CAAC;MACN;IACJ;EACJ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}