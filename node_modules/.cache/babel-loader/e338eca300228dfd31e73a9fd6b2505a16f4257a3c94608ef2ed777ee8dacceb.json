" viewBox=\"0 0 16 16\">\r\n                                <path d=\"M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z\"/>\r\n                                <path d=\"M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z\"/>\r\n                            </svg>\r\n                        </button>\r\n                    </div>\r\n                </div>\r\n                <p class=\"col-12 examples-text\">You can see usage examples in the Examples section, or explore and interact with them in the Playground.</p>\r\n            </div>\r\n        </div>\r\n    </section>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n    name: 'GetStarted',\r\n    methods: {\r\n        CopyNPM() {\r\n            const textToCopy = \"npm i vitral-css@latest\";\r\n            if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\r\n        },\r\n        CopyCSS() {\r\n            const textToCopy = '<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.css\">';\r\n            if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\r\n        },\r\n        CopyJS() {\r\n            const textToCopy = '<script src=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.js\" defer></' + 'script>';\r\n            if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\r\n        }\r\n    }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.get-started {\r\n    padding: 3rem 0;\r\n}\r\n\r\nh2 {\r\n    text-align: center;\r\n    color: aliceblue;\r\n    font-size: 2rem;\r\n    font-family: 'frutiger';\r\n    text-shadow: 0 0 10px rgb(104, 104, 104);\r\n}\r\n\r\n.intro {\r\n    font-size: 1rem;\r\n    text-align: center;\r\n    color: aliceblue;\r\n    font-family: 'frutiger';\r\n    margin: 1rem 0 2rem;\r\n}\r\n\r\nh3 {\r\n    text-align: center;\r\n    color: aliceblue;\r\n    font-size: 1.5rem;\r\n    font-family: 'frutiger';\r\n}\r\n\r\n.install-box {\r\n    background-color: rgba(49, 104, 255, 0.219);\r\n    padding: 1.5rem;\r\n    margin-bottom: 1.5rem;\r\n}\r\n\r\n.install-text {\r\n    font-size: 0.9rem;\r\n    text-align: center;\r\n    color: aliceblue;\r\n    font-family: 'frutiger';\r\n}\r\n\r\n.code-button {\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 1rem;\r\n    width: 100%;\r\n    background-color: rgba(5, 4, 54, 0.651);\r\n    padding: 0.75rem 1rem;\r\n}\r\n\r\n.code-button code {\r\n    font-family: 'frutiger';\r\n    color: aliceblue;\r\n    font-size: 0.8rem;\r\n    text-align: left;\r\n}\r\n\r\n.code-button svg {\r\n    flex-shrink: 0;\r\n}\r\n\r\n.scroll-code {\r\n    display: block;\r\n    white-space: nowrap;\r\n    overflow-x: auto;\r\n    -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.examples-text {\r\n    margin-top: 1.5rem;\r\n    text-align: center;\r\n    font-size: 0.9rem;\r\n    color: aliceblue;\r\n    font-family: 'frutiger';\r\n}\r\n\r\n@media (min-width: 768px) {\r\n    h2 {\r\n        font-size: 2.5rem;\r\n    }\r\n\r\n    .intro {\r\n        font-size: 1.2rem;\r\n    }\r\n\r\n    h3 {\r\n        font-size: 1.75rem;\r\n    }\r\n\r\n    .install-text {\r\n        font-size: 1rem;\r\n    }\r\n\r\n    .code-button code {\r\n        font-size: 1rem;\r\n    }\r\n\r\n    .examples-text {\r\n        font-size: 1rem;\r\n    }\r\n}\r\n\r\n@media (min-width: 992px) {\r\n    h2 {\r\n        font-size: 3rem;\r\n    }\r\n\r\n    .install-box {\r\n        padding: 2rem;\r\n    }\r\n}\r\n</style>\r\n"],"mappings":"AAiDA,eAAe;EACXA,IAAI,EAAE,YAAY;EAClBC,OAAO,EAAE;IACLC,OAAOA,CAAA,EAAG;MACN,MAAMC,UAAS,GAAI,yBAAyB;MAC5C,IAAIC,SAAS,CAACC,SAAS,EAAED,SAAS,CAACC,SAAS,CAACC,SAAS,CAACH,UAAU,CAAC;IACtE,CAAC;IACDI,OAAOA,CAAA,EAAG;MACN,MAAMJ,UAAS,GAAI,4FAA4F;MAC/G,IAAIC,SAAS,CAACC,SAAS,EAAED,SAAS,CAAC