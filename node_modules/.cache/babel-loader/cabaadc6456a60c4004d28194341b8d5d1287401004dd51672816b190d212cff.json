{"ast":null,"code":"export default {\n  name: 'ExamplesView'\n};","map":{"version":3,"names":["name"],"sources":["C:\\Users\\User\\Desktop\\VitraCss-dev\\vitralcss-Web\\src\\views\\ExamplesView.vue"],"sourcesContent":["<template>\n  <div class=\"under-construction water-theme\">\n    <div class=\"container\">\n      <i class=\"fa-solid fa-layer-group icon\"></i>\n      <h1>Examples</h1>\n      <p>Discover what's possible with VitralCSS through practical examples.</p>\n      <router-link to=\"/\" class=\"btn-home Glass-Panel-5 with-hover\">\n        <i class=\"fa-solid fa-house\"></i> Back to Home\n      </router-link>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'ExamplesView'\n}\n</script>\n\n<style scoped>\n.under-construction {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 80px 20px 40px;\n}\n\n.water-theme {\n  background: linear-gradient(135deg, #0a3d62, #1e5f74, #148f77);\n}\n\n.container {\n  text-align: center;\n  max-width: 600px;\n}\n\n.icon {\n  font-size: 80px;\n  color: #60d9f7;\n  margin-bottom: 30px;\n  animation: wave 3s ease-in-out infinite;\n}\n\n@keyframes wave {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-15px); }\n}\n\nh1 {\n  font-family: 'frutiger';\n  font-size: 48px;\n  font-weight: 900;\n  color: #e0f7fa;\n  margin-bottom: 20px;\n  text-shadow: 0 0 20px rgba(96, 217, 247, 0.5);\n}\n\np {\n  font-family: 'frutiger';\n  font-size: 20px;\n  color: #b2ebf2;\n  margin-bottom: 40px;\n}\n\n.btn-home {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  padding: 15px 35px;\n  color: #e0f7fa;\n  text-decoration: none;\n  font-family: 'frutiger';\n  font-size: 18px;\n  transition: all 0.3s ease;\n}\n\n.btn-home:hover {\n  transform: scale(1.05);\n  color: #fff;\n}\n\n@media (max-width: 767px) {\n  .icon {\n    font-size: 60px;\n  }\n  h1 {\n    font-size: 36px;\n  }\n  p {\n    font-size: 18px;\n  }\n}\n</style>\n"],"mappings":"AAcA,eAAe;EACbA,IAAI,EAAE;AACR","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}