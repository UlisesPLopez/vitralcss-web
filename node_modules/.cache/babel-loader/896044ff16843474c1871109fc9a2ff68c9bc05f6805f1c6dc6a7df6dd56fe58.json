{"ast":null,"code":"export default {\n  name: 'GetStarted',\n  methods: {\n    CopyNPM() {\n      const textToCopy = \"npm i vitral-css@latest\";\n      if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\n    },\n    CopyCSS() {\n      const textToCopy = '<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.css\">';\n      if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\n    },\n    CopyJS() {\n      const textToCopy = '<script src=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.js\" defer></' + 'script>';\n      if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\n    }\n  }\n};","map":{"version":3,"names":["name","methods","CopyNPM","textToCopy","navigator","clipboard","writeText","CopyCSS","CopyJS"],"sources":["C:\\Users\\User\\Desktop\\VitraCss-dev\\vitralcss-Web\\src\\views\\home\\GetStarted.vue"],"sourcesContent":["<template>\n    <section class=\"get-started\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"col-12\">\n                    <h2>Get Started</h2>\n                    <p class=\"intro\">VitralCSS is designed for easy implementation and straightforward usage.\n                        You can install it via a package manager or include it through a CDN.</p>\n                </div>\n                <div class=\"col-12\">\n                    <div class=\"Glass-Panel-3 install-box\">\n                        <h3>Install via NPM:</h3>\n                        <p class=\"install-text\">Install VitralCSS using npm.</p>\n                        <button class=\"Glass-Panel-5 code-button\" @click=\"CopyNPM()\">\n                            <code>npm install vitracss</code>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n                                <path d=\"M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z\"/>\n                                <path d=\"M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z\"/>\n                            </svg>\n                        </button>\n                    </div>\n\n                    <div class=\"Glass-Panel-3 install-box\">\n                        <h3>Install via CDN:</h3>\n                        <p class=\"install-text\">Include VitralCSS directly in your HTML.</p>\n                        <button class=\"Glass-Panel-5 code-button\" @click=\"CopyCSS()\">\n                            <code class=\"scroll-code\">&lt;link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.css\"&gt;</code>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n                                <path d=\"M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z\"/>\n                                <path d=\"M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z\"/>\n                            </svg>\n                        </button>\n                        <br><br>\n                        <button class=\"Glass-Panel-5 code-button\" @click=\"CopyJS()\">\n                            <code class=\"scroll-code\">&lt;script src=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.js\" defer&gt;&lt;/script&gt;</code>\n                            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" fill=\"currentColor\" viewBox=\"0 0 16 16\">\n                                <path d=\"M4 1.5H3a2 2 0 0 0-2 2V14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3.5a2 2 0 0 0-2-2h-1v1h1a1 1 0 0 1 1 1V14a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1h1z\"/>\n                                <path d=\"M9.5 1a.5.5 0 0 1 .5.5v1a.5.5 0 0 1-.5.5h-3a.5.5 0 0 1-.5-.5v-1a.5.5 0 0 1 .5-.5zm-3-1A1.5 1.5 0 0 0 5 1.5v1A1.5 1.5 0 0 0 6.5 4h3A1.5 1.5 0 0 0 11 2.5v-1A1.5 1.5 0 0 0 9.5 0z\"/>\n                            </svg>\n                        </button>\n                    </div>\n                </div>\n                <p class=\"col-12 examples-text\">You can see usage examples in the Examples section, or explore and interact with them in the Playground.</p>\n            </div>\n        </div>\n    </section>\n</template>\n\n<script>\nexport default {\n    name: 'GetStarted',\n    methods: {\n        CopyNPM() {\n            const textToCopy = \"npm i vitral-css@latest\";\n            if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\n        },\n        CopyCSS() {\n            const textToCopy = '<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.css\">';\n            if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\n        },\n        CopyJS() {\n            const textToCopy = '<script src=\"https://cdn.jsdelivr.net/npm/vitracss/dist/VitraCss.min.js\" defer></' + 'script>';\n            if (navigator.clipboard) navigator.clipboard.writeText(textToCopy);\n        }\n    }\n}\n</script>\n\n<style scoped>\n.get-started {\n    padding: 3rem 0;\n}\n\nh2 {\n    text-align: center;\n    color: aliceblue;\n    font-size: 2rem;\n    font-family: 'frutiger';\n    text-shadow: 0 0 10px rgb(104, 104, 104);\n}\n\n.intro {\n    font-size: 1rem;\n    text-align: center;\n    color: aliceblue;\n    font-family: 'frutiger';\n    margin: 1rem 0 2rem;\n}\n\nh3 {\n    text-align: center;\n    color: aliceblue;\n    font-size: 1.5rem;\n    font-family: 'frutiger';\n}\n\n.install-box {\n    background-color: rgba(49, 104, 255, 0.219);\n    padding: 1.5rem;\n    margin-bottom: 1.5rem;\n}\n\n.install-text {\n    font-size: 0.9rem;\n    text-align: center;\n    color: aliceblue;\n    font-family: 'frutiger';\n}\n\n.code-button {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 1rem;\n    width: 100%;\n    background-color: rgba(5, 4, 54, 0.651);\n    padding: 0.75rem 1rem;\n}\n\n.code-button code {\n    font-family: 'frutiger';\n    color: aliceblue;\n    font-size: 0.8rem;\n    text-align: left;\n}\n\n.code-button svg {\n    flex-shrink: 0;\n}\n\n.scroll-code {\n    display: block;\n    white-space: nowrap;\n    overflow-x: auto;\n    -webkit-overflow-scrolling: touch;\n}\n\n.examples-text {\n    margin-top: 1.5rem;\n    text-align: center;\n    font-size: 0.9rem;\n    color: aliceblue;\n    font-family: 'frutiger';\n}\n\n@media (min-width: 768px) {\n    h2 {\n        font-size: 2.5rem;\n    }\n\n    .intro {\n        font-size: 1.2rem;\n    }\n\n    h3 {\n        font-size: 1.75rem;\n    }\n\n    .install-text {\n        font-size: 1rem;\n    }\n\n    .code-button code {\n        font-size: 1rem;\n    }\n\n    .examples-text {\n        font-size: 1rem;\n    }\n}\n\n@media (min-width: 992px) {\n    h2 {\n        font-size: 3rem;\n    }\n\n    .install-box {\n        padding: 2rem;\n    }\n}\n</style>\n"],"mappings":"AAiDA,eAAe;EACXA,IAAI,EAAE,YAAY;EAClBC,OAAO,EAAE;IACLC,OAAOA,CAAA,EAAG;MACN,MAAMC,UAAS,GAAI,yBAAyB;MAC5C,IAAIC,SAAS,CAACC,SAAS,EAAED,SAAS,CAACC,SAAS,CAACC,SAAS,CAACH,UAAU,CAAC;IACtE,CAAC;IACDI,OAAOA,CAAA,EAAG;MACN,MAAMJ,UAAS,GAAI,4FAA4F;MAC/G,IAAIC,SAAS,CAACC,SAAS,EAAED,SAAS,CAACC,SAAS,CAACC,SAAS,CAACH,UAAU,CAAC;IACtE,CAAC;IACDK,MAAMA,CAAA,EAAG;MACL,MAAML,UAAS,GAAI,mFAAkF,GAAI,SAAS;MAClH,IAAIC,SAAS,CAACC,SAAS,EAAED,SAAS,CAACC,SAAS,CAACC,SAAS,CAACH,UAAU,CAAC;IACtE;EACJ;AACJ","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}